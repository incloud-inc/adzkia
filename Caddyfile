{
    frankenphp {
        worker /app/public/frankenphp-worker.php {$FRANKENPHP_WORKERS:2}
    }
    order php_server before file_server
}

:80, :3000 {
    root * /app/public
    encode zstd gzip

    # Handle static assets directly with long-lived caching
    @static {
        file
        path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Serve static files
    file_server

    # Pass everything else to Laravel via FrankenPHP Worker Mode
    php_server {
        resolve_root_symlink
    }
}
