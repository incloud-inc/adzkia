{
    frankenphp
    order php_server before file_server
}

:80 {
    root * /app/public
    encode zstd gzip

    # Handle static assets directly with long-lived caching
    @static {
        file
        path *.ico *.css *.js *.gif *.jpg *.jpeg *.png *.svg *.woff *.woff2 *.ttf
    }
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Serve static files
    file_server

    # Pass everything else to Laravel via FrankenPHP
    php_server
}
